    {
        "id": "node_fn_ire",
        "type": "function",
        "z": "tab_ergodesk_01",
        "name": "Validar Esquema + Lux + Cálculo IRE",
        "func": "const d = msg.payload;\n\n// 1. Sanitización y validación de esquema JSON (OWASP I3)\nif (!d || typeof d.angulo_deg !== 'number' || typeof d.luz_pct !== 'number' || typeof d.estado !== 'string') {\n    node.warn('Payload malformado descartado en ergodesk/telemetria');\n    return null;\n}\n\n// 2. Acumuladores históricos de sesión en contexto de flujo\nlet stats = flow.get('sessionStats') || {\n    total: 0,\n    badPosture: 0,\n    lowLight: 0,\n    startMs: Date.now()\n};\n\nstats.total += 1;\nif (d.estado === 'MALA_POSTURA' || d.estado === 'PAUSA_ACTIVA') stats.badPosture += 1;\nif (d.estado === 'POCA_LUZ') stats.lowLight += 1;\nflow.set('sessionStats', stats);\n\n// 3. Curva de calibración LDR (%) -> Lux estimados (Ref. NOM-025-STPS: 300 lx)\nconst luxEstimado = Math.round((d.luz_pct / 100.0) * 600);\n\n// 4. Cálculo del Índice de Riesgo Ergonómico (IRE: 0 a 100)\nconst umbralAng = d.umbral_ang || 18.0;\nconst ratioAngulo = Math.min(d.angulo_deg / umbralAng, 1.5);\nconst scoreAngulo = Math.min(ratioAngulo * 28, 40); // Máx 40 pts\n\nconst pctMalaPostura = (stats.badPosture / stats.total) * 100;\nconst scoreHistorico = (pctMalaPostura / 100) * 35;  // Máx 35 pts\n\nconst deficitLuz = Math.max(0, (300 - luxEstimado) / 300);\nconst scoreLuz = deficitLuz * 25;                    // Máx 25 pts\n\nconst ire = Math.round(Math.min(100, scoreAngulo + scoreHistorico + scoreLuz));\n\n// Etiqueta textual explícita para cumplimiento WCAG 2.1 (1.4.1 Uso del color)\nlet nivelRiesgo = 'RIESGO_BAJO';\nif (ire >= 65) nivelRiesgo = 'RIESGO_ALTO';\nelse if (ire >= 35) nivelRiesgo = 'RIESGO_MODERADO';\n\nconst minutosSesion = Math.round((Date.now() - stats.startMs) / 60000);\n\nmsg.payload = {\n    uptime_s: d.uptime_s,\n    angulo_deg: d.angulo_deg,\n    umbral_ang: umbralAng,\n    luz_pct: d.luz_pct,\n    lux_estimado: luxEstimado,\n    cumple_nom025: luxEstimado >= 300,\n    estado: d.estado,\n    buffered: Boolean(d.buffered),\n    ire: ire,\n    nivel_riesgo: nivelRiesgo,\n    pct_mala_postura: Number(pctMalaPostura.toFixed(1)),\n    minutos_sesion: minutosSesion\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 140,
        "wires": [
            [
                "node_dbg_telemetry",
                "node_fn_adaptive",
                "node_http_cloud"
            ]
        ]
    },
    {
        "id": "node_fn_adaptive",
        "type": "function",
        "z": "tab_ergodesk_01",
        "name": "Ajuste Adaptativo Pausas (Cloud -> Edge)",
        "func": "const d = msg.payload;\nconst now = Date.now();\nconst lastAdjust = flow.get('lastAdaptiveAdjustMs') || 0;\n\n// Si hay deterioro postural sostenido tras 45 min o IRE crítico (>= 70),\n// envía consigna al ESP32 para reducir el intervalo de pausas activas a 30 min.\nconst deterioroProlongado = (d.minutos_sesion >= 45 && d.ire >= 55);\nconst riesgoCritico = (d.ire >= 70 && d.uptime_s >= 30);\n\nif ((deterioroProlongado || riesgoCritico) && (now - lastAdjust > 600000)) {\n    flow.set('lastAdaptiveAdjustMs', now);\n    return {\n        payload: 'PAUSE_MIN:30'\n    };\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 920,
        "y": 200,
        "wires": [
            [
                "node_out_config",
                "node_dbg_config"
            ]
        ]
    },
